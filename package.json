{
  "name": "ashenai",
  "version": "1.0.0",
  "description": "AshenAI — Discord AI bot with Ashen Realms RPG",
  "main": "dist/index.js",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc --noEmit false --outDir dist",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "node node_modules/ts-node/dist/bin.js src/index.ts",
    "test": "node node_modules/jest/bin/jest.js --passWithNoTests"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "@discordjs/rest": "^2.2.0",
    "discord-api-types": "^0.37.61",
    "openai": "^4.28.0",
    "@anthropic-ai/sdk": "^0.20.1",
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.4",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "@types/node": "^20.11.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.2"
  }
}
